FLOWBOARD_DATABASE_PATH=./data/flowboard.db
# Production PostgreSQL; when set it takes precedence over FLOWBOARD_DATABASE_PATH.
DATABASE_URL=
FLOWBOARD_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
FLOWBOARD_AUTH_SECRET=replace-with-at-least-32-random-characters
FLOWBOARD_AUTH_REQUIRED=false
FLOWBOARD_ACCESS_TOKEN_MINUTES=1440
FLOWBOARD_RATE_LIMIT_PER_MINUTE=240
FLOWBOARD_SMTP_HOST=
FLOWBOARD_SMTP_PORT=587
FLOWBOARD_SMTP_USERNAME=
FLOWBOARD_SMTP_PASSWORD=
FLOWBOARD_SMTP_FROM=Flowboard <noreply@flowboard.local>
FLOWBOARD_PUBLIC_APP_URL=http://localhost:4173
FLOWBOARD_API_PUBLIC_URL=http://localhost:8000/api/v1
FLOWBOARD_GOOGLE_CLIENT_ID=
FLOWBOARD_GOOGLE_CLIENT_SECRET=
FLOWBOARD_GITHUB_CLIENT_ID=
FLOWBOARD_GITHUB_CLIENT_SECRET=
FLOWBOARD_MICROSOFT_CLIENT_ID=
FLOWBOARD_MICROSOFT_CLIENT_SECRET=

